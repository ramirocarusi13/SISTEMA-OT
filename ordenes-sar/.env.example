APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Departamentos especiales (App\Support\Departamentos). NO hardcodear ids en
# el código: ver config/ot.php.
# Id del departamento de Mantenimiento (default histórico: 2). Solo cambiar si
# en algún ambiente el id no es 2.
OT_DEPTO_MANTENIMIENTO_ID=2
# Id del departamento de Seguridad e Higiene (SyH). Dejar vacío para que se
# resuelva automáticamente por nombre contra la tabla `departamentos`
# (columna 'nombre' = OT_DEPTO_SEGURIDAD_NOMBRE). Si el departamento SyH no
# existe todavía en esta base (ej. desarrollo local), el sistema funciona
# exactamente igual que antes: nadie tiene el alcance/restricciones de SyH.
OT_DEPTO_SEGURIDAD_ID=
# Nombre exacto del departamento de Seguridad e Higiene en la tabla
# `departamentos`, usado solo si OT_DEPTO_SEGURIDAD_ID no está seteado.
OT_DEPTO_SEGURIDAD_NOMBRE=SyH
